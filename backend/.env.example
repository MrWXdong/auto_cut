AUTOCUT_ENVIRONMENT=dev
# Demo mode accepts any login. Set to false in production.
AUTOCUT_DEMO_MODE=true
AUTOCUT_WORK_ROOT=work
AUTOCUT_MAX_CONCURRENCY=2
# Leave empty/unset to use the bundled imageio-ffmpeg binary.
# AUTOCUT_FFMPEG_BIN=C:/path/to/ffmpeg.exe
AUTOCUT_FFPROBE_BIN=ffprobe
AUTOCUT_LLM_BASE_URL=https://api.deepseek.com
AUTOCUT_LLM_API_KEY=
AUTOCUT_LLM_MODEL=deepseek-chat
AUTOCUT_IMAGE_BASE_URL=
AUTOCUT_IMAGE_API_KEY=
AUTOCUT_IMAGE_MODEL=cogview-3-flash
# 免费测试通道示例：智谱 GLM-4-Flash
# AUTOCUT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AUTOCUT_LLM_MODEL=glm-4-flash
# AUTOCUT_LLM_API_KEY=注册智谱开放平台后填写
AUTOCUT_DEEPSEEK_API_KEY=
AUTOCUT_QWEN_API_KEY=
AUTOCUT_DOUBAO_API_KEY=
# 豆包文本和 Seedream 生图共用同一个方舟 Key。
# 图片模型需在火山方舟控制台开通，也可以填写推理接入点 ep-...
AUTOCUT_DOUBAO_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AUTOCUT_DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 豆包 Seed 2.x 默认关闭思考模式，避免简单文案消耗大量 reasoning token。
AUTOCUT_DOUBAO_THINKING=false
AUTOCUT_ZHIPU_API_KEY=
AUTOCUT_MOONSHOT_API_KEY=
AUTOCUT_ASR_PROVIDER=cloud
AUTOCUT_ASR_BASE_URL=
AUTOCUT_ASR_API_KEY=
AUTOCUT_ASR_MODEL=
AUTOCUT_ASR_LOCAL_MODEL=small
# 智谱云端转写默认使用 glm-asr-2512，并在本地自动按 20 秒分段
AUTOCUT_TTS_PROVIDER=edge
AUTOCUT_TTS_VOICE=zh-CN-XiaoxiaoNeural
AUTOCUT_TTS_RATE=+0%
AUTOCUT_EMBEDDING_PROVIDER=cloud
AUTOCUT_EMBEDDING_BASE_URL=
AUTOCUT_EMBEDDING_API_KEY=
AUTOCUT_EMBEDDING_MODEL=
AUTOCUT_RAG_TOKEN_BUDGET=1200
AUTOCUT_OBJECT_STORAGE_BACKEND=local
AUTOCUT_S3_ENDPOINT_URL=
AUTOCUT_S3_BUCKET=
AUTOCUT_S3_ACCESS_KEY=
AUTOCUT_S3_SECRET_KEY=
AUTOCUT_S3_REGION=auto
AUTOCUT_S3_PREFIX=autocut
AUTOCUT_S3_PATH_STYLE=true
AUTOCUT_S3_PRESIGN_SECONDS=3600
AUTOCUT_SMS_PROVIDER=
AUTOCUT_SMS_ACCESS_KEY_ID=
AUTOCUT_SMS_ACCESS_KEY_SECRET=
AUTOCUT_SMS_SIGN_NAME=
AUTOCUT_SMS_TEMPLATE_CODE=
AUTOCUT_WECHAT_APP_ID=
AUTOCUT_WECHAT_APP_SECRET=
AUTOCUT_WECHAT_REDIRECT_URI=
AUTOCUT_AUTH_SECRET=dev-secret-change-me
AUTOCUT_PLATFORM_ADMIN_EMAIL=admin@local
AUTOCUT_PLATFORM_ADMIN_PASSWORD=admin
AUTOCUT_SEED_DEMO_TENANT=true
AUTOCUT_PAYMENT_WEBHOOK_SECRET=
